# 复制为 .env 后填写。不要把 .env 提交到 Git。

# 排队页免排队口令。留空则关闭该入口。
QUEUE_ADMIN_CODE=

# LinuxDo OAuth。两项都填才会启用。
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# LINUXDO_REDIRECT_URI=https://fps2.zard.loc.cc/auth/callback

# NodeLoc OAuth。两项都填才会启用。
NODELOC_CLIENT_ID=
NODELOC_CLIENT_SECRET=
# NODELOC_REDIRECT_URI=https://fps2.zard.loc.cc/oauth/nodeloc
